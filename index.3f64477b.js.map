"use strict";
var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
wall.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var clickX = e.clientX - wallRect.left - wall.clientLeft;
    var clickY = e.clientY - wallRect.top - wall.clientTop;
    var x = clickX - spider.offsetWidth / 2;
    var y = clickY - spider.offsetHeight / 2;
    var maxLeft = wall.clientWidth - spider.offsetWidth;
    var maxTop = wall.clientHeight - spider.offsetHeight;
    if (x < 0) x = 0;
    if (x > maxLeft) x = maxLeft;
    if (y < 0) y = 0;
    if (y > maxTop) y = maxTop;
    spider.style.left = x + "px";
    spider.style.top = y + "px";
});

